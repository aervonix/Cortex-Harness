# Breaks for step 12 (the permission engine, `cortex-policy`), from pull request 25.
# Reconstructed from the pull request description and the crate's tests, not
# from the lists the step kept: each rule is one the description names.

[break] deny-beats-ask
rule: Deny beats ask beats allow, whatever the order: an ask must never outrank a deny.
file: crates/cortex-policy/src/rules.rs
in: strength
find: RuleAction::Ask => 1
replace: RuleAction::Ask => 3
caught-by:
    rules::tests::deny_beats_ask_beats_allow_whatever_the_order

[break] learned-allow-needs-no-trust
rule: A project's allow, and one learned for the project, waits for trust; a learned allow must wait too.
file: crates/cortex-policy/src/rules.rs
in: RuleSource::allow_needs_trust
find: matches!(self, Self::Project | Self::Learned)
replace: matches!(self, Self::Project)
caught-by:
    rules::tests::a_projects_allow_waits_for_trust_and_its_deny_does_not
    bypasses::a_repository_cannot_grant_itself_anything

[break] allow-anywhere-is-everywhere
rule: An allow that starts with `**` means the workspace, not the whole machine.
file: crates/cortex-policy/src/rules.rs
in: RuleSet::compile
find: exact: exact.kept_within(context.workspace)
replace: exact
caught-by:
    rules::tests::an_allow_that_starts_anywhere_is_an_allow_in_the_workspace

[break] autonomous-without-sandbox
rule: The autonomous level is refused where the sandbox does not enforce.
file: crates/cortex-policy/src/level.rs
in: check_standing
find:
    SandboxState::NotEnforcing(why) => Err(LevelError::SandboxRequired {
        level: level.clone(),
        why,
    })
replace: SandboxState::NotEnforcing(_) => Ok(())
caught-by:
    level::tests::autonomous_is_refused_where_the_sandbox_does_not_enforce
    levels::autonomous_is_refused_where_the_sandbox_does_not_enforce

[break] child-may-be-unrestricted
rule: A child lease never gets the unrestricted level, which is not passed down.
file: crates/cortex-policy/src/lease.rs
in: narrow_in
find: &Level::Autonomous
replace: &Level::Unrestricted
caught-by:
    lease::tests::a_child_takes_the_lower_level_and_never_unrestricted

[break] child-allow-without-parent
rule: An allow rule of a proposal reaches the child only if the parent has the same rule.
file: crates/cortex-policy/src/lease.rs
in: narrow_in
find: rule.action == RuleAction::Allow && ours.rules.contains(rule)
replace: rule.action == RuleAction::Allow
caught-by:
    lease::tests::deny_and_ask_rules_are_carried_over_and_an_allow_needs_the_parents

[break] circleci-not-protected
rule: CI configuration (here `.circleci`) is a protected path of the workspace: a write to it goes to the user.
file: crates/cortex-policy/src/lease.rs
find: ".circleci"
replace: ".circleci-unprotected"
caught-by:
    bypasses::a_sensitive_path_is_never_written_unasked

[break] ssh-key-by-prefix-only
rule: Only the usual names of an SSH private key look like secrets; other names that begin `id_` are ordinary files.
file: crates/cortex-policy/src/secrets.rs
in: looks_secret
find: SSH_KEYS.contains(&name.as_str())
replace: name.starts_with("id_")
caught-by:
    secrets::tests::ordinary_files_are_not

[break] nested-git-dir-is-source
rule: Anything in a `.git` directory, at any depth, goes to the user to write.
file: crates/cortex-policy/src/engine.rs
in: is_repository_data
find: path.names().any(|name| name.eq_ignore_ascii_case(".git"))
replace: false
caught-by:
    bypasses::git_configuration_is_never_changed_unasked
    bypasses::a_sensitive_path_is_never_written_unasked

[break] git-config-after-option-value
rule: `git config` is recognised after git's own options, including those that take a value in the next word.
file: crates/cortex-policy/src/engine.rs
in: is_git_config
find: words.next();
replace: let _ = &words;
caught-by:
    bypasses::git_configuration_is_never_changed_unasked

[break] redirect-is-a-read
rule: A redirection to a file is a write of that file, judged by the write rules.
file: crates/cortex-policy/src/engine.rs
in: Engine::judge_part
find: (target, Effect::Write)
replace: (target, Effect::Read)
caught-by:
    bypasses::a_redirection_is_a_write_of_its_file

[break] session-approves-a-deny
rule: An approval for the session can only allow; a deny is never kept as an approval.
file: crates/cortex-policy/src/approvals.rs
in: SessionApprovals::add
find: rules.iter().filter(|rule| rule.action == RuleAction::Allow)
replace: rules.iter()
caught-by:
    approvals::tests::session_approvals_are_held_once_and_removed_by_id

[break] trust-ignores-the-pin
rule: A project's allow rules are trusted only while they are the ones the user saw: a changed set is disabled until approved again.
file: crates/cortex-policy/src/trust.rs
in: ProjectTrust::allows_rules
find: self.standing(&Definition::of_rules(rules)).is_approved()
replace: self.is_trusted()
caught-by:
    trust::a_projects_allow_rules_are_disabled_when_they_change_after_trust
    trust::tests::a_projects_allow_rules_are_pinned_together_whatever_their_order

[break] unlisted-short-option-allowed
rule: An option that is not listed takes a command off the table of read-only commands (`sort -o out`).
file: crates/cortex-policy/src/command/table.rs
in: unix_allows
find: _ => return false
replace: _ => {}
occurrence: 2
caught-by:
    bypasses::nothing_that_writes_or_runs_is_ever_marked_read_only

[break] git-on-the-table-untrusted
rule: `git` is on the table of read-only commands only in a trusted project.
file: crates/cortex-policy/src/command/table.rs
in: read_only
find: entry.needs_trust && !trusted
replace: false
caught-by:
    commands::git_is_asked_about_in_a_project_that_is_not_trusted

[break] dollar-is-a-word
rule: Command analysis fails closed: a `$` (variable or substitution) makes the line not modelled.
file: crates/cortex-policy/src/command/posix.rs
find: '$' => refuse("`$`: a variable or another expansion")
replace:
    '$' => {
        self.word().text.push(character);
        Ok(())
    }
caught-by:
    command::posix::tests::what_the_analysis_does_not_model_is_refused
    bypasses::an_allow_rule_never_carries_a_second_command
