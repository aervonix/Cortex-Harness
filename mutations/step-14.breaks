# Breaks for step 14 (the `anthropic-messages` protocol, `cortex-llm`), from pull request 21.
# Reconstructed from the pull request description and the tests, not from the
# lists the step kept: each rule is one the description names.

[break] cache-marker-after-lookback
rule: The one extra cache marker is written only when the round is longer than the provider's lookback; a round exactly as long as the lookback has none.
file: crates/cortex-llm/src/anthropic/request.rs
in: Body::long_round
find: positions > LOOKBACK
replace: positions >= LOOKBACK
caught-by:
    anthropic::request::a_round_longer_than_the_lookback_gets_one_more_marker

[break] replay-only-readable-blocks
rule: Anthropic's own API gets every reasoning block of its own earlier messages back, whatever the model (the flag `replay_reasoning` is `all`).
file: crates/cortex-llm/src/anthropic/request.rs
in: replay
find: readable || flags::replays_every_block(provider)
replace: readable
caught-by:
    anthropic::request::the_same_provider_gets_every_block_back_whatever_the_model

[break] stored-block-not-checked
rule: A stored block is sent back as the text that was stored only when it is one JSON object; anything else falls back to the neutral fields.
file: crates/cortex-llm/src/anthropic/request.rs
in: stored_block
find: .filter(|text| json::is_object(text))
replace:
caught-by:
    anthropic::request::a_stored_block_that_is_not_one_object_is_never_written_into_a_body

[break] tool-call-id-kept-as-is
rule: A tool call id from another provider is written with only the characters this provider takes, so a call and its result still name each other.
file: crates/cortex-llm/src/anthropic/request.rs
in: wire_id
find: !id.is_empty() && id.bytes().all(fits)
replace: true
caught-by:
    anthropic::request::a_call_id_from_another_provider_is_written_as_one_this_provider_takes

[break] speed-sent-to-every-model
rule: A model that offers no speed tier is not told a speed: the real API refuses the field for it.
file: crates/cortex-llm/src/anthropic/request.rs
in: sends_speed
find: !request.model.info.speeds.is_empty()
replace: true
caught-by:
    anthropic::request::a_request_at_fast_speed

[break] speed-beta-without-a-tier
rule: The beta name for a speed is sent only where the request names a speed; the flag on a model with no tier asks for nothing.
file: crates/cortex-llm/src/anthropic/mod.rs
in: build
find: request::sends_speed(request) &&
replace:
caught-by:
    anthropic::request::the_beta_header_is_sent_where_a_model_needs_it_for_a_speed

[break] spend-cap-is-a-rate-limit
rule: A spending cap arrives as a 429 like a rate limit, and its detail code wins: it is a hard stop, never retried.
file: crates/cortex-llm/src/anthropic/classify.rs
in: signal
find:
    if detail == Some(SPEND_LIMIT) {
        return Signal::Quota;
    }
replace:
caught-by:
    anthropic::classify::tests::every_documented_error_type_has_its_signal
    anthropic::classify::a_spending_cap_at_fast_speed_is_a_hard_stop

[break] too-large-413-is-not-overflow
rule: Any 413 is a context overflow, even when the body names no error type (a proxy's HTML page).
file: crates/cortex-llm/src/anthropic/classify.rs
in: error
find: Signal::None if status == Some(413) => Signal::ContextLength
replace: Signal::None if status == Some(413) => Signal::None
caught-by:
    anthropic::classify::a_failure_with_no_readable_body_is_read_by_its_status

[break] tier-claims-model-limit
rule: A refusal at a speed tier belongs to the model, not the tier, when the standard headers say nothing is left and the tier's own say something is.
file: crates/cortex-llm/src/anthropic/classify.rs
in: refused_by_tier
find: tier_used_up || !standard_used_up
replace: true
caught-by:
    anthropic::classify::the_fast_tiers_own_limit_and_capacity

[break] shared-limit-tier-rate-limit
rule: A rate limit can only be the speed tier's when the tier has a limit of its own.
file: crates/cortex-llm/src/anthropic/classify.rs
in: refused_by_tier
find: Throttle::RateLimit if offer.separate_limit => {}
replace: Throttle::RateLimit => {}
caught-by:
    anthropic::classify::the_fast_tiers_own_limit_and_capacity

[break] fast-limits-not-labelled
rule: The fast tier's own limits from the headers are labelled with the tier.
file: crates/cortex-llm/src/anthropic/classify.rs
in: read_headers
find: speed: fast.then_some(Speed::Fast)
replace: speed: None
caught-by:
    anthropic::classify::the_headers_of_a_good_response_give_the_id_and_the_limits

[break] block-index-used-twice
rule: An index names one block for the whole response: a block that starts under an index already used is an error.
file: crates/cortex-llm/src/anthropic/decode.rs
in: Decoder::block_start
find: !self.seen.insert(index)
replace: false
caught-by:
    anthropic::decode::a_stream_that_breaks_the_dialect_is_an_error_and_not_a_guess

[break] unknown-events-not-skipped
rule: An event of a kind the decoder does not know is skipped.
file: crates/cortex-llm/src/anthropic/decode.rs
in: Decoder::feed
find:
    if !KNOWN_EVENTS.contains(&kind) {
        return Ok(());
    }
replace:
caught-by:
    anthropic::decode::what_is_not_known_is_skipped_and_nothing_else_is

[break] context-window-stop-is-max-output
rule: A response that filled the context window stops as a context overflow, which the loop answers by compacting.
file: crates/cortex-llm/src/anthropic/decode.rs
in: stop_reason
find: "model_context_window_exceeded" => StopReason::ContextOverflow
replace: "model_context_window_exceeded" => StopReason::MaxOutput
caught-by:
    anthropic::decode::every_stop_reason_arrives_in_its_neutral_form

[break] cache-read-added-to-input
rule: The provider's input count does not include cache reads, so the cache read tokens are reported as their own count and nothing is added to the input.
file: crates/cortex-llm/src/anthropic/decode.rs
in: UsageSoFar::merge
find: self.tokens.cache_read = count;
replace: self.tokens.input += count;
caught-by:
    anthropic::decode::cache_tokens_are_reported_by_class
