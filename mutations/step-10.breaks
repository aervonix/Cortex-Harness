# Step 10 (pull request 23): the editing tools and the plan, in cortex-tools.
# Reconstructed from the pull request description, the code's own
# documentation and the tests, not recorded when the step was built.

[break] stale-file-overwritten
rule: A file that changed on disk since the session read it is not written or edited.
file: crates/cortex-tools/src/change.rs
in: Target::guard
find: env.files.staleness(self.path.abs(), &existing.hash)
replace:
    match env.files.staleness(self.path.abs(), &existing.hash) {
        Staleness::Stale => Staleness::Current,
        other => other,
    }
caught-by:
    editing::a_file_that_changed_since_it_was_read_is_not_overwritten

[break] unread-file-overwritten
rule: A file that exists and was never read in the session is not written or edited.
file: crates/cortex-tools/src/change.rs
in: Target::guard
find: env.files.staleness(self.path.abs(), &existing.hash)
replace:
    match env.files.staleness(self.path.abs(), &existing.hash) {
        Staleness::Unseen => Staleness::Current,
        other => other,
    }
caught-by:
    editing::a_file_that_was_not_read_is_not_overwritten

[break] file-changed-during-call-replaced
rule: A file that was replaced by another between the read and the write is not written over.
file: crates/cortex-tools/src/change.rs
in: Target::still_as_found
find: Stamp::of(&now) == existing.stamp
replace: true
caught-by:
    change::tests::a_file_that_changes_between_the_read_and_the_write_is_not_replaced

[break] cancelled-call-still-writes
rule: A call cancelled before its write changes nothing and says so.
file: crates/cortex-tools/src/change.rs
in: Target::commit
find: env.cancel.is_cancelled()
replace: false
caught-by:
    change::tests::a_call_cancelled_before_the_write_changes_nothing

[break] checkpoint-given-no-bytes
rule: The checkpoint is handed the bytes the tool read, so that the change can be undone.
file: crates/cortex-tools/src/change.rs
in: Target::commit
find: Found::File(existing) => Some(existing.bytes.as_slice())
replace: Found::File(_) => None
caught-by:
    change::tests::a_change_that_goes_through_is_recorded_as_what_the_file_now_is

[break] size-limit-is-exclusive
rule: A file of exactly the limit (16 MiB in the product) is changed; only a larger one is refused.
file: crates/cortex-tools/src/change.rs
in: Target::find
find: metadata.len() > limit
replace: metadata.len() >= limit
caught-by:
    editing::a_file_too_large_to_keep_for_undo_is_refused_with_another_way

[break] mark-dropped-by-edit
rule: An edit keeps the file's byte-order mark byte for byte.
file: crates/cortex-tools/src/edit.rs
in: edit_file
find: if marked { new.push_str(BOM); }
replace: if marked && false { new.push_str(BOM); }
caught-by:
    editing::line_endings_and_a_mark_survive_an_edit_byte_for_byte

[break] tolerant-tier-not-reported
rule: When the tolerant tier made the match, the result says so and shows the text it replaced.
file: crates/cortex-tools/src/edit.rs
in: edit_file
find: report_tolerant(&mut message, call.edits.len(), &places)
replace: report_tolerant(&mut String::new(), call.edits.len(), &places)
caught-by:
    editing::the_tolerant_tier_is_reported_with_the_text_it_replaced

[break] other-count-accepted
rule: An old that occurs a number of times other than count is refused, not edited.
file: crates/cortex-tools/src/matching.rs
in: locate_one
find: ranges.len() != edit.count
replace: ranges.len() < edit.count
caught-by:
    matching::tests::every_one_of_count_occurrences_is_replaced_and_any_other_number_is_refused

[break] tolerant-tier-tried-after-wrong-count
rule: The tolerant tier is tried only when the exact tier finds nothing, not when it finds the wrong number.
file: crates/cortex-tools/src/matching.rs
in: locate_one
find: !starts.is_empty()
replace: starts.len() == edit.count
caught-by:
    matching::tests::the_tolerant_tier_is_used_only_when_the_exact_tier_finds_nothing

[break] overlapping-edits-allowed
rule: Two edits that would replace the same text are refused.
file: crates/cortex-tools/src/matching.rs
in: locate
find: second.range.start < first.range.end
replace: second.range.start < first.range.start
caught-by:
    matching::tests::edits_are_matched_against_the_file_as_it_was_and_must_not_overlap

[break] partial-edits-returned
rule: Either every edit has its place or none is applied: a call with a failed edit applies nothing.
file: crates/cortex-tools/src/matching.rs
in: locate
find: failures.is_empty()
replace: failures.is_empty() || !found.is_empty()
caught-by:
    matching::tests::every_failure_of_a_call_is_reported_and_nothing_is_applied
    editing::either_every_edit_applies_or_none_does

[break] write-forgets-line-endings
rule: New content written over a file takes that file's line endings.
file: crates/cortex-tools/src/matching.rs
in: rewrite
find: vec![old.dominant; new_lines.len()]
replace: vec![crate::textfile::Ending::Lf; new_lines.len()]
caught-by:
    matching::tests::new_content_takes_the_line_endings_of_the_file_it_replaces
    editing::write_keeps_the_line_endings_and_the_mark_of_the_file_it_replaces

[break] plan-call-crossing-an-edit-replaces
rule: A user's edit to the plan wins: a plan call written without it replaces nothing and returns the current plan.
file: crates/cortex-tools/src/plan.rs
in: PlanBoard::replace
find: !unseen.is_empty()
replace: false
caught-by:
    plan::a_call_that_crosses_a_users_edit_replaces_nothing_and_returns_the_current_plan

[break] plan-same-round-counts-as-shown
rule: An edit a call was told of counts as shown only to a call of a later round, not to one written beside it in the same response.
file: crates/cortex-tools/src/plan.rs
in: PlanBoard::replace
find: told >= round
replace: told > round
caught-by:
    plan::a_call_that_crosses_a_users_edit_replaces_nothing_and_returns_the_current_plan

[break] plan-delivered-clears-later-edits
rule: A notice reaching the model clears only the edits up to its revision; later edits stay news.
file: crates/cortex-tools/src/plan.rs
in: PlanBoard::delivered
find: unseen.revision > revision
replace: false
caught-by:
    plan::an_edit_whose_notice_was_delivered_does_not_hold_up_the_next_call

[break] plan-call-not-marked-session-change
rule: A plan call says that it changes the session, so the loop never starts it before the response has ended.
file: crates/cortex-tools/src/plan.rs
find: Plan::new(summary, items).with_session_change()
replace: Plan::new(summary, items)
caught-by:
    plan::the_call_touches_nothing_outside_the_session_and_says_that_it_changes_the_session

[break] remember-stores-duplicates
rule: A proposal for an entry that is already known is not stored again.
file: crates/cortex-tools/src/remember.rs
find: known.kind == proposal.kind && known.text == proposal.text
replace: false
caught-by:
    remember::a_proposal_is_stored_as_proposed_with_where_it_was_learned
