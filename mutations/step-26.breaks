file: crates/cortex-core/src/policy.rs
in: EnginePolicy::answers_may_stop
find: self.fail_on_denial || self.sandboxed.load(std::sync::atomic::Ordering::Acquire)
replace: self.fail_on_denial
caught-by:
    cortex-core::it sandbox::while_commands_are_confined_a_later_call_waits_for_the_open_question

[break] a-wrapped-tool-loses-its-preview
rule: The guard around every tool keeps the tool's preview, so that a question about a change to a file still shows the change.
file: crates/cortex-core/src/checkpoints.rs
in: StopsWithTurn::preview
find: self.tool.preview(plan, cx)
replace: { let _ = (plan, cx); None }
caught-by:
    cortex-core::it approvals::an_approval_for_a_change_to_a_file_shows_the_change_within_a_bound
