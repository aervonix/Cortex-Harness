# Step 15: context management, in cortex-agent, and what it added to
# cortex-core.
#
# Each rule of the context is broken here: the frozen prefix, appended
# notices, epochs at a change of model, the carried state, replayed turns
# without reasoning, the redaction mark, the budget, background summaries
# and the overflow fallback, and what may be read as an instruction file.

[break] notice-edits-the-system-prompt
rule: A changed instruction file is appended as a notice; the system prompt is not rewritten within the epoch.
file: crates/cortex-agent/src/turn/epochs.rs
in: Session::tell_changes
find: self.record_notice(turn, NoticeSource::Instructions, text).await?;
replace: if let Some(epoch) = self.context.epoch.as_mut() { epoch.system.push_str(&text); }
caught-by:
    cortex-agent::it context::changed_new_and_removed_instruction_files_are_told_as_notices
    cortex-agent::it context::the_prefix_holds_over_a_long_session_and_breaks_when_history_is_edited

[break] tools-reordered-inside-an-epoch
rule: The tool list is fixed for the epoch: every request of it declares the same tools in the same order.
file: crates/cortex-agent/src/context/mod.rs
in: Context::assemble
find: .map(|epoch| (epoch.system.clone(), epoch.tools.clone()))
replace: .map(|epoch| { let mut tools = epoch.tools.clone(); let count = tools.len().max(1); tools.rotate_left(self.history.len() % count); (epoch.system.clone(), tools) })
caught-by:
    cortex-agent::it context::the_prefix_holds_over_a_long_session_and_breaks_when_history_is_edited

