replace: && false
caught-by:
    denials::a_later_write_waits_for_an_answer_that_may_stop_the_turn

[break] answers-may-stop-ignored
rule: A later call runs beside a question whose answers cannot stop the turn.
file: crates/cortex-agent/src/round.rs
in: Round::pump
find: let stop_may_answer = self.env.policy.answers_may_stop();
replace: let stop_may_answer = true;
caught-by:
    denials::a_later_write_runs_beside_a_question_that_cannot_stop_the_turn

# Finding 10: a deny is matched against the line with its quotes taken out.

[break] deny-matched-only-as-written
rule: A deny or ask rule is matched against the raw line as written and with its quotes taken out.
file: crates/cortex-policy/src/command/pattern.rs
in: ExecPattern::restricts
find: || self.restricts_words(&loose_words(&unquoted(line)))
replace:
caught-by:
    bypasses::a_deny_is_not_dodged_by_splitting_the_programs_name

[break] line-break-after-a-backslash-kept
rule: A backslash before a line break joins the two lines in one word, for matching a deny.
file: crates/cortex-policy/src/command/pattern.rs
in: unquoted
find: .fold(line.to_owned(), |line, join| line.replace(join, ""))
replace: .fold(line.to_owned(), |line, _| line)
caught-by:
    command::pattern::tests::a_deny_matches_wherever_its_words_appear

