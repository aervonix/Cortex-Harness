in: may_name
find: text.match_indices('=')
replace: text.match_indices('=').take(1)
caught-by:
    bypasses::patterns_and_lost_directories_hold_against_the_second_review

# Finding 7: what an approval reaches.

[break] no-subcommand-allow-list
rule: An approval of a program with subcommands covers only the subcommands that choose what is built or shown.
file: crates/cortex-policy/src/engine.rs
in: approval_rule
find: || SUBCOMMANDS
replace: || false && SUBCOMMANDS
caught-by:
    engine::tests::an_approval_covers_the_program_and_its_subcommand

[break] curl-not-the-exact-line
rule: An approval of `curl` covers only the exact line.
file: crates/cortex-policy/src/engine.rs
in: EXACT_LINE
find: "curl",
replace: "curl-never",
caught-by:
    approvals::an_approval_reaches_no_further_than_the_line_it_was_given_for

[break] no-version-after-a-name
rule: `python3.12` is approved as `python` is: a version after the name changes nothing.
file: crates/cortex-policy/src/engine.rs
in: approval_rule
find: list.contains(&name) || list.contains(&unversioned)
replace: list.contains(&name) || unversioned.is_empty()
caught-by:
    approvals::an_approval_reaches_no_further_than_the_line_it_was_given_for

[break] windows-endings-not-stripped
rule: `npm.cmd` is `npm`, as Windows finds it, for what an approval covers.
file: crates/cortex-policy/src/engine.rs
in: approval_rule
find: [".exe", ".cmd", ".bat", ".com", ".ps1"]
replace: [".exe-never"]
caught-by:
    engine::tests::an_approval_covers_the_program_and_its_subcommand

