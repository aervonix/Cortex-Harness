# Breaks for the fixes to step 12 (the permission engine, `cortex-policy`):
# the findings of the review of step 12, the glob hole, and what the three
# independent reviews of the fixes found. Each was run while the fixes were
# made, and is kept here so that the tests stay seen to bite.

# Finding 1: an option whose value is only attached hides nothing after it.

[break] git-log-pretty-takes-the-next-word
rule: `git log --pretty` takes its value only attached, so the word after it is checked as an argument of its own.
file: crates/cortex-policy/src/command/table.rs
in: GIT_LOG
find: LO("pretty")
replace: LV("pretty", T)
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

[break] git-diff-u-takes-the-next-word
rule: `git diff -U` takes its value only attached, so the word after it is checked as an argument of its own.
file: crates/cortex-policy/src/command/table.rs
in: GIT_DIFF
find: SO('U')
replace: SV('U', T)
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

[break] git-diff-relative-takes-the-next-word
rule: `git diff --relative` takes its value only attached, so the word after it is checked as an argument of its own.
file: crates/cortex-policy/src/command/table.rs
in: GIT_DIFF
find: LO("relative")
replace: LV("relative", T)
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

[break] git-stash-list-pretty-takes-the-next-word
rule: `git stash list --pretty` takes its value only attached, so the word after it is checked as an argument of its own.
file: crates/cortex-policy/src/command/table.rs
in: GIT_STASH_LIST
find: LO("pretty")
replace: LV("pretty", T)
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

[break] no-out-backstop
rule: A git line with `--out` in any word is never on the table of commands that only read.
file: crates/cortex-policy/src/command/table.rs
in: read_only
find: word.text.contains("--out")
replace: word.text.contains("--out-never")
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

# Finding 2: PowerShell quoting that reaches a program as other words.

[break] powershell-quoted-text-not-checked
rule: A PowerShell quoted text that reaches a program as other words than the parser read is not modelled.
file: crates/cortex-policy/src/command/powershell.rs
in: quoted
find: reaches_a_program_whole(&text)?;
replace:
caught-by:
    bypasses::powershell_quoting_that_reaches_a_program_as_other_words_is_asked_about
    command::powershell::tests::anything_else_is_refused

[break] powershell-quoted-text-ends-with-a-backslash
rule: A PowerShell quoted text that ends with a backslash is not modelled.
file: crates/cortex-policy/src/command/powershell.rs
in: reaches_a_program_whole
find: if text.ends_with('\\')
replace: if text.ends_with("never")
caught-by:
    command::powershell::tests::anything_else_is_refused

[break] powershell-empty-quoted-text
rule: An empty PowerShell quoted text is not modelled: Windows PowerShell drops it.
file: crates/cortex-policy/src/command/powershell.rs
in: reaches_a_program_whole
find: if text.is_empty()
replace: if false
caught-by:
    command::powershell::tests::anything_else_is_refused

[break] powershell-cmd-characters-in-quoted-text
rule: A PowerShell quoted text with `& | < > ^ %` in it is not modelled: `cmd.exe` reads them again.
file: crates/cortex-policy/src/command/powershell.rs
in: reaches_a_program_whole
find: matches!(character, '&' | '|' | '<' | '>' | '^' | '%')
replace: matches!(character, '\u{0}')
caught-by:
    command::powershell::tests::anything_else_is_refused

[break] powershell-quote-in-quoted-text
rule: A PowerShell quoted text with a `"` in it is not modelled.
file: crates/cortex-policy/src/command/powershell.rs
in: reaches_a_program_whole
find: if text.contains('"')
replace: if text.contains('\u{0}')
caught-by:
    command::powershell::tests::anything_else_is_refused

# Finding 3: `cd`.

[break] any-cd-target-followed
rule: A `cd` is followed only where its target says where it starts: `/`, `~`, `./`, `../`, `.` or `..`.
file: crates/cortex-policy/src/engine.rs
in: Engine::follow_cd
find: self.cd_target(&directory.logical, target, true)?
replace: self.cd_target(&directory.logical, target, false)?
caught-by:
    bypasses::a_cd_is_followed_only_where_its_target_says_where_it_starts

[break] cd-followed-through-the-file-system
rule: `..` in a `cd` is taken logically, as the shell takes it, not through links.
file: crates/cortex-policy/src/engine.rs
in: Engine::follow_cd
find: let real = self.locate.locate(&moved, moved.as_str())?;
replace: let real = self.locate.locate(&directory.real, &target.text)?;
caught-by:
    real_paths::unix::a_cd_through_a_link_takes_dot_dot_as_the_shell_does

[break] nothing-checked-after-a-lost-cd
rule: What comes after a `cd` that is not followed is still checked from every place it may run in.
file: crates/cortex-policy/src/engine.rs
in: Engine::judge_command
find: findings.extend(self.judge_lost(rules, part, lost, !changes_directory, listing));
replace: let _ = (&lost, listing);
caught-by:
    bypasses::a_cd_is_followed_only_where_its_target_says_where_it_starts
    bypasses::git_configuration_is_never_changed_unasked

[break] no-guess-where-a-lost-cd-leads
rule: After a `cd` that is not followed, where it would lead with no `CDPATH` is a place too.
file: crates/cortex-policy/src/engine.rs
in: Lost::after
find: lost.moved_by(engine, part);
replace:
caught-by:
    bypasses::a_cd_is_followed_only_where_its_target_says_where_it_starts

[break] cd-double-dash-not-read
rule: `cd -- dir` is `cd dir`.
file: crates/cortex-policy/src/engine.rs
in: cd_operand
find: if text == "--"
replace: if text == "--never"
caught-by:
    bypasses::a_cd_with_options_or_a_redirection_still_says_where_it_leads

[break] cd-p-followed
rule: `cd -P` takes `..` through links, and is not followed.
file: crates/cortex-policy/src/engine.rs
in: cd_operand
find: 'P' => physical = true,
replace: 'P' => physical = false,
caught-by:
    bypasses::a_cd_with_options_or_a_redirection_still_says_where_it_leads

[break] lost-cd-with-a-redirection-not-tracked
rule: A `cd` with a redirection, after one that was not followed, still moves the places.
file: crates/cortex-policy/src/engine.rs
in: Engine::judge_command
find: if changes_directory { lost.moved_by(self, part); }
replace: if changes_directory && part.redirects.is_empty() { lost.moved_by(self, part); }
caught-by:
    bypasses::a_cd_with_options_or_a_redirection_still_says_where_it_leads

# Findings 4 and 5: searches that reach hidden and ignored files.

[break] rg-on-the-table
rule: `rg` is not on the table of commands that only read: it reads hidden and ignored files, and runs programs.
file: crates/cortex-policy/src/command/table.rs
in: POSIX
find: row(&["fd", "fdfind"], unix(FD, PATHS)),
replace: row(&["fd", "fdfind"], unix(FD, PATHS)), row(&["rg"], unix(FD, PATHS)),
caught-by:
    bypasses::a_search_that_reaches_hidden_and_ignored_files_is_asked_about

[break] git-grep-no-index
rule: `git grep --no-index` reads files git does not track, and is not on the table.
file: crates/cortex-policy/src/command/table.rs
in: GIT_GREP
find: L("cached"),
replace: L("cached"), L("no-index"),
caught-by:
    bypasses::a_search_that_reaches_hidden_and_ignored_files_is_asked_about

[break] git-grep-untracked
rule: `git grep --untracked` reads files git does not track, and is not on the table.
file: crates/cortex-policy/src/command/table.rs
in: GIT_GREP
find: L("cached"),
replace: L("cached"), L("untracked"),
caught-by:
    bypasses::a_search_that_reaches_hidden_and_ignored_files_is_asked_about

[break] git-diff-of-two-paths-on-the-table
rule: `git diff` of two paths outside a repository compares any two files, and is not on the table.
file: crates/cortex-policy/src/command/table.rs
find: compares_paths: true
replace: compares_paths: false
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

[break] a-path-with-a-dot-component-reads-as-a-revision
rule: A word with `/.` in it is a path, not a git revision: `src/../docs` is no range.
file: crates/cortex-policy/src/command/table.rs
in: reads_as_revision
find: || text.contains("/.")
replace:
caught-by:
    command::table::tests::a_command_with_anything_unlisted_is_not_on_the_table

# Finding 6: a path attached to a short option.

[break] no-attached-short-values
rule: A path attached to a short option (`-o.git/x`) is checked like any other.
file: crates/cortex-policy/src/engine.rs
in: may_name
find: texts.extend(text.char_indices().skip(2).map(|(at, _)| &text[at..]));
replace:
caught-by:
    bypasses::a_path_attached_to_a_short_option_is_checked_like_any_other

[break] only-the-first-equals-value
rule: The value after every `=` of a word is checked as a path.
